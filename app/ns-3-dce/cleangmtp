#!/bin/bash        

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
NS3DIR="$repo_root/linux/ns3/linux-net-next-nuse-latest/tools/testing/libos/buildtop/source/ns-3-dce"
old="wscript.orig"

for i in $( ls gmtp ); do
    echo Deleting link to: $i
    rm -f $NS3DIR/example/$i
done

ls -l $NS3DIR/example/ | grep gmtp

echo Restoring old wscript...
for j in $( ls $NS3DIR | grep $old ); do
    rm $NS3DIR/wscript
    mv -f $NS3DIR/$j $NS3DIR/wscript
done

ls -l $NS3DIR | grep wscript

echo

