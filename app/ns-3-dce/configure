#!/bin/bash
# Hook the GMTP scenarios into the DCE tree built by
# app/ns-3-dce/provision/build-dce.sh. DCE picks up myscripts/<dir>/wscript,
# so this only creates one symlink and does not replace DCE's wscript.
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
NS3DIR="$repo_root/linux/ns3/linux-net-next-nuse-latest/tools/testing/libos/buildtop/source/ns-3-dce"

if [[ ! -d "$NS3DIR/myscripts" ]]; then
    echo "DCE tree not found: $NS3DIR (run provision/build-dce.sh first)" >&2
    exit 1
fi

ln -sfn "$script_dir/gmtp" "$NS3DIR/myscripts/gmtp"
ls -l "$NS3DIR/myscripts/gmtp"
