+static void lib_timer_mark(struct timer_list *timer, int armed)
+{
+	timer->entry.next = NULL;
+	timer->entry.pprev = armed ? LIB_TIMER_ARMED : NULL;
+}
+
+/* forget a timer: cancel its event, drop it from the expired queue */
+static int lib_timer_forget(struct timer_list *timer)
+{
+	struct lib_timer *l_timer = lib_timer_find(timer);
+	int was_armed = 0;
+
+	if (!l_timer)
+		return 0;
+	if (l_timer->event) {
+		lib_event_cancel(l_timer->event);
+		l_timer->event = NULL;
+		was_armed = 1;
+	}
+	if (l_timer->on_exp) {
+		list_del(&l_timer->exp);
+		l_timer->on_exp = 0;
+		was_armed = 1;
+	}
+	hlist_del(&l_timer->t_hash);
+	lib_free(l_timer);
+	return was_armed;
+}
