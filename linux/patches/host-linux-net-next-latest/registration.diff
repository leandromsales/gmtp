diff --git a/net/core/secure_seq.c b/net/core/secure_seq.c
index 6a6f2cda5..301139fb0 100644
--- a/net/core/secure_seq.c
+++ b/net/core/secure_seq.c
@@ -134,3 +134,18 @@ u64 secure_ipv4_port_ephemeral(__be32 saddr, __be32 daddr, __be16 dport)
 }
 EXPORT_SYMBOL_GPL(secure_ipv4_port_ephemeral);
 #endif
+
+__u32 secure_gmtp_sequence_number(__be32 saddr, __be32 daddr,
+				   __be16 sport, __be16 dport)
+{
+	u64 seq;
+
+	net_secret_init();
+	seq = siphash_3u32((__force u32)saddr, (__force u32)daddr,
+			   (__force u32)sport << 16 | (__force u32)dport,
+			   &net_secret);
+	seq += ktime_get_real_ns();
+	seq &= (1ull << 48) - 1;
+	return seq;
+}
+EXPORT_SYMBOL(secure_gmtp_sequence_number);
