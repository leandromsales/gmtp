#!/bin/bash        
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
NS3DIR="$repo_root/linux/ns3/linux-net-next-nuse-latest/tools/testing/libos/buildtop/source/ns-3-dce"
results="results"
subfolder="gmtp"

if [ $# -gt 0 ]; then
    subfolder=$1
fi

mkdir $results/$subfolder

for i in $( ls $NS3DIR | grep "files-" ); do
    echo Reading i: $i
    for j in $( ls $NS3DIR/$i | grep ".log" ); do
        echo "  $j"
        cp $NS3DIR/$i/$j $results/$subfolder
        sed -i '$ d' $results/$subfolder/$j
    done
done

find $results/$subfolder/ -size "-4k" -exec rm {} \;

echo
